@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/index.css" />


@section Scripts {
    @* This is the script used on this page for the buttons and API calls, found in wwwroot/js/index.js *@
    <script src="~/js/index.js" defer></script>
}

@* This is the only view used in the project *@
<div class="text-center dx-viewport">
    <h1 class="display-4">Welcome</h1>

    <h3>Data Entry</h3>

    <div class="data-entry">
        <section class="data-entry-fields">

            <div id="numberBoxContainer"></div>

            <div id="textBoxContainer"></div>

            <div id="selectBoxContainer"></div>

            <div id="tagBoxContainer"></div>

        </section>

        <div id="dataEntryButton"></div>

        <div id="dataPopup"></div>
    </div>

    <h3>Press the button to see course and student data</h3>

    <div id="buttonContainer"></div>

    @* Conditional display of course/student data only after button is pressed *@

    <div class="data-div" id="dataDiv">

        <hr />

        <h2>Course Averages</h2>
        
        <div id="chartContainer"></div>

        <hr />

        <h2>Student Grades</h2>

        <h3>Add a Student</h3>

        <div id="addStudentForm"></div>
        <div id="addStudentButton"></div>

        <div id="studentDataDiv"></div>
    </div>
</div>
